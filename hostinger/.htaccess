# Portafolio en Hostinger: React compilado (build/) + chatbot en PHP.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # El frontend llama a /api/chat (como en Vercel) -> api/chat.php
    RewriteRule ^api/chat/?$ api/chat.php [L]
</IfModule>

# La clave de la API nunca se entrega por web
<Files "clave.php">
    Require all denied
</Files>
<Files "clave.example.php">
    Require all denied
</Files>

# index.html siempre se revisa (los JS/CSS de static/ llevan hash en el nombre)
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
